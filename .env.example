# Copy to .env (gitignored) and fill in. Never commit real values.
# GitHub read-only personal access token, used for repo/commit lookups.
GITHUB_TOKEN=
# Discord webhook for brief run updates from `kitsunox collect` (decision 0011). Optional.
KITSUNOX_DISCORD_WEBHOOK=
# Stage 5: where you put package-analysis's results/ from the airgapped analysis VM
# (docs/stages/sandbox.md). Not a secret. Unset: collect skips Stage 5.
KITSUNOX_SANDBOX_RESULTS=
