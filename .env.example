# Copy to .env and adjust. All settings are optional; defaults are in kitsunox/config.py.

# --- Storage ---
# KITSUNOX_DB_URL=sqlite:///data/kitsunox.db
# KITSUNOX_DATA_DIR=data

# --- npm replication feed ---
# KITSUNOX_REPLICATE_BASE_URL=https://replicate.npmjs.com/registry
# KITSUNOX_REGISTRY_BASE_URL=https://registry.npmjs.org
# KITSUNOX_DOWNLOADS_BASE_URL=https://api.npmjs.org
# KITSUNOX_DEPS_DEV_BASE_URL=https://api.deps.dev
# KITSUNOX_CHANGES_PAGE_LIMIT=1000
# KITSUNOX_POLL_INTERVAL_SECONDS=15
# Where to start when the feed cursor is empty: "now" | "now-<N>" (N seq units back) | "0"
# KITSUNOX_FEED_START=now

# --- HTTP ---
# KITSUNOX_HTTP_TIMEOUT_SECONDS=30
# KITSUNOX_USER_AGENT=kitsunox/0.1 (+https://github.com/TheStair/kitsunox)

# --- Threat intel mirror ---
# KITSUNOX_OSV_QUERY_URL=https://api.osv.dev/v1/query
# KITSUNOX_MALICIOUS_PACKAGES_REPO=https://github.com/ossf/malicious-packages

# --- Tier 2 LLM (not used this pass) ---
# ANTHROPIC_API_KEY=
